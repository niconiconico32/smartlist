{
  "expo": {
    "name": "Brainy",
    "slug": "brainy",
    "version": "1.0.15",
    "orientation": "default",
    "updates": {
      "url": "https://u.expo.dev/0025faea-a07f-4447-9b45-fd5edb5469a9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.15",
    "icon": "./assets/images/appstorelogo.png",
    "scheme": "brainy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#280D8C"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "We convert your voice to text for rapid task creation. This helps users with ADHD capture ideas instantly before distractions cause a loss of focus.",
        "NSMicrophoneUsageDescription": "Usamos el micrófono para que dictes tus tareas y tu mascota las organice.",
        "NSPhotoLibraryUsageDescription": "Brainy necesita acceso a tu galería para que puedas personalizar tu perfil con una foto.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.brainyahdh.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealthAndFitness",
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ],
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealthAndFitness",
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ],
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false
          }
        ],
        "NSPrivacyTracking": false
      },
      "buildNumber": "13"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appstorelogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.brainyahdh.app",
      "versionCode": 18,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.brainyahdh.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.brainyahdh.app",
          "widgets": [
            {
              "name": "RoutinesWidget",
              "displayName": "Brainy Rutinas",
              "description": "Tus rutinas del día con Brainy",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true,
            "enableJetpackCompose": true,
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Necesitamos acceso a tu micrófono para que puedas dictar nuevas tareas."
        }
      ],
      "expo-audio",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/appstorelogo.png",
          "color": "#CBA6F7",
          "defaultChannel": "routines"
        }
      ],
      "expo-apple-authentication",
      "./plugins/withRemoveBootReceiver",
      "./plugins/withUnrestrictMLKitOrientation",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RoutinesWidget",
              "label": "Rutinas Brainy",
              "minWidth": "320dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "56dp",
              "description": "Muestra tus rutinas del día.",
              "previewImage": "./assets/images/logomain.png",
              "resizeMode": "none"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0025faea-a07f-4447-9b45-fd5edb5469a9"
      }
    }
  }
}
